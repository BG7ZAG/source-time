{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1",
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      {
        // 开启应用级沉浸光感（HarmonyOS 26 / API 26 系统材质）。
        // 只有在 entry 类型模块中配置才会生效；未开启时 ImmersiveMaterial 不产生任何效果。
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        // 当前版本联网同步已关闭（WEBDAV_FEATURE_ENABLED = false），先移除网络权限。
        // 备案完成、恢复 WebDAV / 跨设备同步时，需在此重新加回：
        // { "name": "ohos.permission.INTERNET" }
        // 多设备协同权限（DISTRIBUTED_DATASYNC）同样只在恢复联网同步后才需要。
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 手机 → 手表同步 WebDAV 配置：仅在同一账号的可信设备间传输，配置本身再用一次性 PIN 加密。
        // 当前版本联网同步关闭，不会发起跨设备传输；备案完成后随功能开关一起启用。
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:distributed_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 关键资产类应用必备：setWindowPrivacyMode 需要该权限（normal 级，安装即授予）。
        // 缺失时调用返回 201，截屏/录屏/多任务预览将不再被遮蔽。
        "name": "ohos.permission.PRIVACY_WINDOW"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 平板上允许分屏与悬浮窗：验证码最常见的用法就是「一边浏览器登录、一边看码」。
        // 不声明时系统默认只给 fullscreen，平板侧的分屏入口直接不可用。
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
